{
  "name": "factoryforge",
  "version": "0.4.0",
  "private": true,
  "description": "通用 3D 数字孪生编辑器（行业资产包 + 3D 资产管理）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
